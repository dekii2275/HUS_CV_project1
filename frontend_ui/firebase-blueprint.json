{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user profile information including callsign and avatar.",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "The operator's callsign."
        },
        "avatarUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL to the operator's neural avatar image."
        },
        "unit": {
          "type": "string",
          "description": "The unit the operator belongs to."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the last modification."
        }
      },
      "required": ["username", "unit"]
    },
    "Incident": {
      "title": "Traffic Incident",
      "description": "Information about a traffic incident (collision, debris, etc.)",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "severity": { "type": "string", "enum": ["Critical", "Elevated", "Nominal"] },
        "location": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Active", "Resolved", "Pending"] },
        "node": { "type": "string" },
        "operatorId": { "type": "string" },
        "description": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "required": ["type", "severity", "location", "timestamp", "status"]
    },
    "Violation": {
      "title": "Traffic Violation",
      "description": "Automated violation detection record.",
      "type": "object",
      "properties": {
        "plate": { "type": "string" },
        "type": { "type": "string" },
        "location": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "confidence": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "imageUrl": { "type": "string", "format": "uri" }
      },
      "required": ["plate", "type", "location", "timestamp", "status"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Individual user profiles mapped by Auth UID."
    },
    "incidents/{incidentId}": {
      "schema": "Incident",
      "description": "Global traffic incidents."
    },
    "violations/{violationId}": {
      "schema": "Violation",
      "description": "Global traffic violations."
    }
  }
}
